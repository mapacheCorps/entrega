@startuml
!pragma layout smetana
!theme plain
skinparam shadowing false
skinparam classAttributeIconSize 0
hide methods
hide circle
title MODELO DE DOMINIO UML  |  2. GESTION Y SEGUIMIENTO

class Estudiante {
  identificador: texto
  nombre: texto
  correo: texto
}

class Experto {
  identificador: texto
  nombre: texto
  correo: texto
  especialidad: texto
}

class VersionApunte {
  numero: entero
  nombreArchivo: texto
  referenciaArchivo: texto
  estado: texto
  especialidadRequerida: texto [0..1]
}

class Notificacion {
  identificador: texto
  contenido: texto
  estadoEntrega: texto
}

class ReporteError {
  identificador: texto
  descripcion: texto
  estado: texto
}

class RevisionAcademica {
  identificador: texto
  fecha: fecha
  decision: texto
  alcance: texto
  retroalimentacion: texto
}

VersionApunte "1" -- "0..*" Notificacion : origina
Estudiante "1" -- "0..*" Notificacion : recibe
VersionApunte "1" -- "0..*" ReporteError : recibe
Estudiante "1" -- "0..*" ReporteError : informa
VersionApunte "1" *-- "0..1" RevisionAcademica : conserva
Experto "0..1" -- "0..*" RevisionAcademica : revisa como Experto
@enduml
