@startuml
!pragma layout smetana
left to right direction
skinparam shadowing false
title Torpedos universitarios — Casos de uso
actor "Estudiante autor" as Autor
actor "Estudiante consultante" as Consultante
actor "Académico" as Academico
actor "Moderador / Comunidad estudiantil" as Moderador
actor "Almacenamiento" as Archivos
actor "Correo" as Correo
rectangle "Torpedos universitarios" {
  usecase "CU-01 Enviar aporte" as CU1
  usecase "CU-02 Consultar cola de revisión" as CU2
  usecase "CU-03 Revisar y registrar decisión" as CU3
  usecase "CU-04 Reenviar aporte corregido" as CU4
  usecase "CU-05 Conocer resultado" as CU5
  usecase "CU-06 Buscar material" as CU6
  usecase "CU-07 Consultar ficha y vista previa" as CU7
  usecase "CU-08 Descargar versión" as CU8
  usecase "CU-09 Reportar error" as CU9
  usecase "CU-10 Consultar alertas de demora" as CU10
  usecase "CU-11 Corregir o retirar versión" as CU11
  usecase "CU-12 Iniciar sesión institucional" as CU12
}
Autor -- CU1
Academico -- CU1
Autor -- CU4
Autor -- CU5
Moderador -- CU2
Moderador -- CU3
Moderador -- CU10
Moderador -- CU11
Consultante -- CU6
Consultante -- CU7
Consultante -- CU8
Consultante -- CU9
Autor -- CU12
Academico -- CU12
Consultante -- CU12
Archivos -- CU1
Archivos -- CU7
Archivos -- CU8
Correo -- CU5
@enduml
