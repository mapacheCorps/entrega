@startuml
title HU-05 - Notificar resolución de un aporte (propuesto)
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName DejaVu Sans
skinparam sequence {
  ArrowColor #26638A
  LifeLineBorderColor #7093AB
  LifeLineBackgroundColor #F5F9FC
  ParticipantBorderColor #2A5D85
  ParticipantBackgroundColor #E6F2FB
  ActorBorderColor #2A5D85
  GroupBorderColor #647E93
  GroupBackgroundColor #F5F8FB
}

autoactivate off
actor "Moderador /\nComunidad" as MOD
actor "Experto en\nla materia" as EXP <<actor externo>>
participant "Torpedos\nuniversitarios" as SIS
participant "Servicio externo\nde correo" as COR <<sistema externo>>
actor "Autor del\naporte" as AUT

group Decision de revision (HU-03)
  alt Revisión por Comunidad
    MOD -> SIS : registrarDecisionFinal(aporteId, versionId,\ndecision, observaciones)
  else Revisión por Experto (materia especializada)
    MOD -> SIS : solicitarRevisionExperto(aporteId, versionId, materia)
    EXP -> SIS : consultarBandejaExperta()
    SIS --> EXP : mostrarVersionesDerivadas()
    EXP -> SIS : evaluacionExperto(decision, alcance, observaciones)
  end
end
note over MOD,SIS
  La decisión pertenece al flujo de revisión (HU-03).
  Se vincula a la versión exacta del aporte.
  HU-05 comunica el resultado final al autor.
  La decisión puede provenir de la Comunidad o de un Experto.
end note

alt [decisión = APROBADA y versión publicada]
  SIS -> COR : enviarCorreo(autor, aporteId, versionId,\nenlacePublicacion)
  COR --> SIS : solicitudAceptada(idMensaje)
  COR -> AUT : correoDeAprobacion(enlacePublicacion)
else [decisión = RECHAZADA]
  SIS -> COR : enviarCorreo(autor, aporteId, versionId,\nmotivoRechazo)
  COR --> SIS : solicitudAceptada(idMensaje)
  COR -> AUT : correoDeRechazo(motivoRechazo)
else [decisión = SOLICITUD DE CORRECCIÓN]
  SIS -> COR : enviarCorreo(autor, aporteId, versionId,\nobservacionesCorreccion)
  COR --> SIS : solicitudAceptada(idMensaje)
  COR -> AUT : correoDeCorreccion(observacionesCorreccion)
end

note over SIS,COR
  La aceptación del proveedor no garantiza
  entrega efectiva al buzón del destinatario.
  El correo es una integración propuesta.
end note
@enduml
