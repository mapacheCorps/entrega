@startuml
!pragma layout smetana
!theme plain
skinparam shadowing false
skinparam classAttributeIconSize 0
hide methods
hide circle
title MODELO DE DOMINIO UML  |  1. APORTE Y REVISION

class ComunidadEstudiantil {
  identificador: texto
  nombre: texto
}

class Estudiante {
  identificador: texto
  nombre: texto
  correo: texto
}

class Academico {
  identificador: texto
  nombre: texto
  correo: texto
}

class Experto {
  identificador: texto
  nombre: texto
  correo: texto
  especialidad: texto
}

class Aporte {
  identificador: texto
  fechaEnvio: fecha
  procedenciaDeclarada: texto
  estado: texto
}

class VersionApunte {
  numero: entero
  nombreArchivo: texto
  referenciaArchivo: texto
  estado: texto
  especialidadRequerida: texto [0..1]
}

class RevisionAcademica {
  identificador: texto
  fecha: fecha
  decision: texto
  alcance: texto
  retroalimentacion: texto
}

ComunidadEstudiantil "1" o-- "1..*" Estudiante : agrupa
Estudiante "0..1" -- "0..*" Aporte : presenta
Academico "0..1" -- "0..*" Aporte : presenta
Aporte "1" *-- "1..*" VersionApunte : contiene
VersionApunte "1" *-- "0..1" RevisionAcademica : conserva
ComunidadEstudiantil "1" -- "0..*" RevisionAcademica : coordina
Estudiante "0..1" -- "0..*" RevisionAcademica : registra como Moderador
Experto "0..1" -- "0..*" RevisionAcademica : revisa como Experto
ComunidadEstudiantil "0..1" -- "0..*" VersionApunte : deriva a Experto

note right of RevisionAcademica
  Una decisión tiene un único revisor:
  Moderador o Experto {xor}.
end note

note bottom of Aporte
  Cada Aporte tiene exactamente un autor:
  un Estudiante o un Academico (restriccion xor).
end note
@enduml
